// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  username String @unique 
  email String @unique
  password String
  role Role @default(USER)
  createdAt DateTime @default(now())
  favorites Favorite[]
}

model CelestialBody {
  id Int @id @default(autoincrement())
  name String
  type String
  description String
  distance Float
  imageUrl String?
  favorites Favorite[]
  resources Resource[]
}

model Resource {
  id Int @id @default(autoincrement())
  title String 
  type String
  url String?
  celestialBodyId Int?
  favorites Favorite[]
  celestial CelestialBody? @relation(fields: [celestialBodyId], references: [id], onDelete: Cascade)
}

model Favorite {
  id Int @id @default(autoincrement())
  userId Int
  celestialBodyId Int?
  resourceId Int?
  createdAt DateTime @default(now())
  celestialBody CelestialBody? @relation(fields: [celestialBodyId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, celestialBodyId])
  @@unique([userId, resourceId])
}

enum Role {
  USER
  ADMIN
}